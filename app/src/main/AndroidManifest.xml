<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="5"
    android:versionName="0.2.1"
    >

    <application
        android:allowBackup="false"
        android:name=".BaseApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/vault_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/vault_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dockeep">
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dockeep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.activity.ShareReceiverActivity"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:theme="@style/TransparentActivityTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <provider android:name=".data.files.VaultProvider"
            android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".ui.activity.PreviewActivity" android:exported="false" />
        <activity android:name=".ui.activity.SafetyActivity" android:exported="false" />
    </application>

</manifest>